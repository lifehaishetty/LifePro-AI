# Life Pro.AI Server Configuration
PORT=3000

# Choose ANY Nemotron model on Nebius Token Factory:
# 1. nvidia/llama-3.1-nemotron-70b-instruct  (RECOMMENDED: Fast, smart, top JSON output)
# 2. nvidia/nemotron-4-340b-instruct         (Heavyweight 340B flagship model)
# 3. nvidia/nemotron-mini-4b-instruct        (Ultra-fast, lowest latency)
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Nebius Token Factory API Key (Never put in Android app or commit to git!)
NEBIUS_API_KEY=YOUR_NEBIUS_API_KEY_HERE

# ElevenLabs Voice API Key (Optional for voice output)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE
