<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet for Nemotron AI communication -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Microphone for "Hello Life" wake word and voice commands -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phone calls for 112 Indian SOS and emergency contact calling -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Location for guardian live tracking during SOS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Camera for video check-in and guardian view -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Background Protection Services (Keeps voice listener alive with screen off) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeProAI"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AuthActivity"
            android:exported="false" />

        <!-- Background Safety Service -->
        <service
            android:name=".SafetyForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />
    </application>

</manifest>
