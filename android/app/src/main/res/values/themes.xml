<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Dark Luxury Black, Violet, and Red accents -->
    <style name="Theme.LifeProAI" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/violet_primary</item>
        <item name="colorPrimaryInverse">@color/violet_light</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/red_emergency</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_body</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.LifePro.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.LifePro.Card.Violet" parent="Widget.LifePro.Card">
        <item name="cardBackgroundColor">@color/violet_tint</item>
        <item name="strokeColor">@color/violet_primary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <style name="Widget.LifePro.Card.Emergency" parent="Widget.LifePro.Card">
        <item name="cardBackgroundColor">@color/red_tint</item>
        <item name="strokeColor">@color/red_emergency</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.LifePro.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/violet_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.LifePro.Button.Emergency" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/red_emergency</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="Widget.LifePro.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/bg_elevated</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
